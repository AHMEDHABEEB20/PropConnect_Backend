PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/propconnect

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# SMTP (Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="PropConnect <noreply@example.com>"

# CORS — comma-separated origins, or * for all
CORS_ORIGIN=http://localhost:3000

# Behind reverse proxy (nginx, Render, etc.) — set to 1 so rate limiting uses real client IP
TRUST_PROXY=0

# Auth routes rate limit (per IP): window in ms, max requests per window
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# Global API rate limit for non-auth routes
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=200

# Auth middleware user cache TTL in ms (set 0 to disable)
AUTH_USER_CACHE_TTL_MS=30000

# API base: GET /api/v1/health — auth: POST /api/v1/auth/register|login|verify-otp
